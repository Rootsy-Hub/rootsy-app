# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend) — requiere reiniciar `npm run dev` tras cambiar estas vars
RESEND_API_KEY=
RESEND_FROM="Rootsy <notificaciones@tudominio.com>"
# Opcional: dirección de respuesta para correos transaccionales
# RESEND_REPLY_TO=soporte@tudominio.com

# ARCA / AFIP
ARCA_PADRON_AFIP_ENV=homologacion

# Mercado Pago — billing de plataforma Rootsy
# Public key para Bricks en el browser (creación de POP / tarjeta)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Access token del vendedor (server-side: cobros y consulta de pagos)
MERCADOPAGO_ACCESS_TOKEN=
# Secret del webhook (Tu integración > Webhooks > Revelar clave)
MERCADOPAGO_WEBHOOK_SECRET=

# Mercado Pago — conexión de comercios (OAuth del POP)
# Client ID / Secret de la app en Tus integraciones (no uses el ACCESS_TOKEN de billing)
MERCADOPAGO_COMMERCE_CLIENT_ID=
MERCADOPAGO_COMMERCE_CLIENT_SECRET=
# Clave para cifrar tokens del POP (64 hex o cualquier string; si falta, se deriva del CLIENT_SECRET)
MERCADOPAGO_COMMERCE_TOKEN_KEY=
# Redirect URI exacta cargada en la app MP. Default: {NEXT_PUBLIC_APP_URL}/api/integrations/mercadopago/callback
# MERCADOPAGO_COMMERCE_REDIRECT_URI=
# NEXT_PUBLIC_APP_URL=

# Alta / ventas (opcional). Si falta, Enterprise abre un mailto.
# NEXT_PUBLIC_SALES_URL=https://cal.com/tu-espacio

# Rootsy — sugerencias en el menú (opcional; reglas sin key)
# Gemini (recomendado, tier gratis en Google AI Studio)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Chat Rootsy: gemini | openai (solo server; no usar NEXT_PUBLIC_)
# Con openai, si falla por cuota/timeout/429/5xx/red, se intenta Gemini.
# ROOTSY_CHAT_AI_PROVIDER=gemini
# OpenAI — chat Rootsy (GPT-5.4 mini)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# Prompts guardados en platform.openai.com (Responses API)
# OPENAI_PROMPT_ROOTSY=pmpt_...
# OPENAI_PROMPT_PLANIFICADOR=pmpt_...
# Planificador de herramientas (barato, separado del chat). Default: Gemini si hay key.
# ROOTSY_CHAT_PLANNER_PROVIDER=gemini
# ROOTSY_CHAT_PLANNER_MODEL=gemini-3.5-flash-lite
# Panel DEV del chat (pasos del flujo). Apagado por default. 1 o true para prenderlo.
# NEXT_PUBLIC_ROOTSY_CHAT_SHOW_DEV_TRACE=1

# rootsy-api (solo server; el browser no pega acá)
# ROOTSY_API_URL=http://localhost:8787
# ROOTSY_API_SECRET=
# HMAC del runner de Rootsy IA (distinto de ROOTSY_API_SECRET). Solo server.
# ROOTSY_AI_EXECUTION_SECRET=

# WebSocket directo al Worker (el browser no usa el secret).
# En local: `npm run dev:worker` en rootsy-api. Si falta, el provider queda idle.
# NEXT_PUBLIC_ROOTSY_REALTIME_URL=http://localhost:8787

CRON_SECRET=
BILLING_TRIAL_JOB_ENABLED=true
BILLING_ALERTS_ENABLED=true
