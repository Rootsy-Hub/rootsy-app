# =============================================================================
# rootsy-web — contrato de entorno
# Copiá a .env.local y completá. Reiniciá `npm run dev` tras cambiar vars.
# NEXT_PUBLIC_* se expone al browser. El resto es solo server.
# =============================================================================

# -----------------------------------------------------------------------------
# OBLIGATORIAS — sin estas la app no autentica ni habla con datos
# -----------------------------------------------------------------------------

# --- App ---
# URL canónica (auth, mails, OAuth MP). Si falta: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Proyecto Rootsy (URL pública)
NEXT_PUBLIC_SUPABASE_URL=
# Anon key (cliente + middleware)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (server privilegiado). Nunca NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- rootsy-api (BFF) ---
# Base del Worker/API. El browser no pega acá.
ROOTSY_API_URL=http://localhost:8787
# Candado server-to-server. El mismo valor va en rootsy-api.
ROOTSY_API_SECRET=
# HMAC del runner de Rootsy IA. Distinto de ROOTSY_API_SECRET.
ROOTSY_AI_EXECUTION_SECRET=

# =============================================================================
# OPCIONALES — la app arranca; el feature no (o usa default)
# =============================================================================

# --- Mercado Pago · billing de plataforma ---
# Public key para Bricks (alta de POP / tarjeta)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Access token del vendedor (cobros y consulta de pagos)
MERCADOPAGO_ACCESS_TOKEN=
# Firma del webhook. En producción, sin esto el webhook no se valida.
# MERCADOPAGO_WEBHOOK_SECRET=

# --- Mercado Pago · comercios (OAuth del POP) ---
# Client ID de la app en Tus integraciones (no uses el ACCESS_TOKEN de billing)
MERCADOPAGO_COMMERCE_CLIENT_ID=
# Client secret de esa app
MERCADOPAGO_COMMERCE_CLIENT_SECRET=
# Cifrado de tokens del POP. Si falta, se deriva del CLIENT_SECRET.
MERCADOPAGO_COMMERCE_TOKEN_KEY=
# Redirect URI exacta en la app MP. Default: {NEXT_PUBLIC_APP_URL}/api/integrations/mercadopago/callback
# MERCADOPAGO_COMMERCE_REDIRECT_URI=

# --- Email (Resend) ---
# Sin API key no se mandan mails (invitaciones, billing).
RESEND_API_KEY=
# Remitente. Tiene que ser un dominio verificado en Resend.
RESEND_FROM="Rootsy <noreply@tudominio.com>"
# Reply-To de transaccionales
# RESEND_REPLY_TO=soporte@tudominio.com

# --- ARCA / AFIP ---
# Padrón A5: production | homologation (inglés; no usar "homologacion")
ARCA_PADRON_AFIP_ENV=production
# Modo AFIP global: homologacion | homologation. Si falta, no es homo.
# ROOTSY_ARCA_AFIP_MODE=homologacion
# Bridge HTTP del padrón. Si falta, va directo a AFIP.
# PADRON_BRIDGE_URL=
# 1 = mock local del padrón
# PADRON_USE_MOCK=1

# --- IA · menú y chat Rootsy ---
# Gemini (menú + fallback del chat)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# gemini | openai (solo server). Con openai, si falla, se intenta Gemini.
ROOTSY_CHAT_AI_PROVIDER=openai
# OpenAI — chat Rootsy. Obligatorio si el provider es openai.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# Prompts guardados en platform.openai.com (Responses API)
OPENAI_PROMPT_ROOTSY=
OPENAI_PROMPT_PLANIFICADOR=
# Planificador de herramientas. Default: Gemini si hay key.
# ROOTSY_CHAT_PLANNER_PROVIDER=gemini
# ROOTSY_CHAT_PLANNER_MODEL=gemini-3.5-flash-lite
# Spec de consultas (Vender) y traza del chat Rootsy. 1 o true para prenderlo.
# NEXT_PUBLIC_DEVMODE=1

# --- Realtime ---
# WebSocket del Worker. Si falta, el provider queda idle.
# En local: `npm run dev:worker` en rootsy-api.
NEXT_PUBLIC_ROOTSY_REALTIME_URL=http://localhost:8787

# --- POP Rootsy (operaciones de ingresos SaaS) ---
# UUID del POP interno (fallback si no está en Uroboros → Bridge Rootsy).
# ROOTSY_POP_ID=

# --- Cron / jobs de billing ---
# Bearer del cron. En producción, sin esto el job queda cerrado.
# CRON_SECRET=
# Job de fin de trial. Default true.
BILLING_TRIAL_JOB_ENABLED=true
# Mails de alerta de billing. Default true.
BILLING_ALERTS_ENABLED=true

# --- Landing ---
# Calendario de ventas. Si falta, Enterprise abre mailto.
# NEXT_PUBLIC_SALES_URL=https://cal.com/tu-espacio
# NEXT_PUBLIC_LOGIN_URL=/login
# NEXT_PUBLIC_REGISTER_URL=/register
# Foto de hero. Default: asset del repo.
# NEXT_PUBLIC_LANDING_HERO_BG=/nombre-de-tu-archivo.webp
